# Salin menjadi .env.local lalu sesuaikan. Berkas .env.local tidak masuk git.
#
# PERINGATAN: apa pun yang berawalan VITE_ ikut ter-bundle ke berkas JavaScript
# yang diunduh browser. Jangan pernah menaruh rahasia (password, secret key,
# token) di sini — nilainya bisa dibaca siapa saja lewat DevTools.

# Basis URL API. Kosongkan saat development supaya memakai proxy Vite
# (satu origin, tanpa CORS). Isi saat build produksi, mis. https://api.erdigma.com
VITE_API_BASE_URL=

# Target proxy Vite saat development — port Spring Boot lokal.
VITE_DEV_PROXY_TARGET=http://localhost:8082

# Mode autentikasi: "dummy" memakai header X-Dummy-Cognito-Sub (hanya untuk
# development lokal), "cognito" memakai token JWT sungguhan.
# Nilai "dummy" DITOLAK saat build produksi.
VITE_AUTH_MODE=dummy
